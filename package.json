{
  "name": "@cobaltintelligence/cli",
  "version": "0.2.0",
  "description": "Official Cobalt Intelligence CLI — Secretary of State, OFAC, TIN, and full-verification lookups from your terminal.",
  "keywords": [
    "cobalt",
    "cobaltintelligence",
    "sos",
    "secretary-of-state",
    "ofac",
    "tin",
    "business-verification",
    "kyb",
    "cli",
    "ai-agents",
    "mcp"
  ],
  "license": "MIT",
  "author": "Cobalt Intelligence <support@cobaltintelligence.com>",
  "homepage": "https://github.com/cobalt-intelligence/cobalt-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cobalt-intelligence/cobalt-cli.git"
  },
  "bugs": {
    "url": "https://github.com/cobalt-intelligence/cobalt-cli/issues"
  },
  "bin": {
    "cobalt": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "!dist/__tests__",
    "!dist/**/*.test.*",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "test": "tsc && node --test dist/__tests__/*.test.js",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "conf": "^10.2.0",
    "ora": "^5.4.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  }
}
